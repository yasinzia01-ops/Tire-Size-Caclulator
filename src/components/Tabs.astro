---
/**
 * Tabs with a tiny progressive-enhancement script. Without JS every panel is shown.
 * Panels are passed as named slots: panel-0, panel-1, …
 */
interface Props { labels: string[]; id: string }
const { labels, id } = Astro.props;
const panels = await Promise.all(labels.map((_, i) => Astro.slots.render(`panel-${i}`)));
---
<div class="tabs" data-tabs>
  <div class="tablist" role="tablist" hidden>
    {labels.map((l, i) => (
      <button type="button" role="tab" id={`${id}-tab-${i}`} aria-controls={`${id}-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{l}</button>
    ))}
  </div>
  {panels.map((html, i) => (
    <div class="panel" role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} set:html={html} />
  ))}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const list = root.querySelector<HTMLElement>('[role=tablist]')!;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>(':scope > [role=tabpanel]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        panels[j]!.hidden = i !== j;
      });
      if (focus) tabs[i]!.focus();
    };
    list.hidden = false;
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) select((i + d + tabs.length) % tabs.length, true);
      });
    });
    select(0);
  }
</script>

<style>
  .tablist { display: flex; flex-wrap: wrap; gap: 5px; }
  .tablist[hidden] { display: none; }
  [role='tab'] {
    border: 0; border-radius: 3px 3px 0 0; cursor: pointer;
    padding: 12px 15px; min-width: 46px; background: var(--navy-3); color: rgb(255 255 255 / .8);
    font: 700 12px/1 var(--font-body);
  }
  [role='tab'][aria-selected='true'] { background: var(--red-bright); color: #fff; }
  .panel { background: #fff; border: 1px solid #ddd; border-radius: 0 10px 10px 10px; padding: 20px; }
  .panel + .panel { margin-top: 16px; }
  .tablist:not([hidden]) ~ .panel { margin-top: 0; }
</style>
