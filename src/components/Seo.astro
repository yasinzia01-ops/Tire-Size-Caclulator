---
import { SITE } from '../data/site';

export interface Props {
  title: string;
  description?: string;
  /** Root-relative path with trailing slash; defaults to the current URL. */
  path?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** JSON-LD objects, emitted one <script> each. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogType = 'website',
  ogImage = SITE.defaultOgImage,
  schema = [],
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const image = new URL(ogImage, SITE.url).href;
const robots = noindex
  ? 'noindex, follow'
  : 'follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large';
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<meta property="og:locale" content="en_US" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:image" content={image} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={image} />

{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
