---
/** Accessible accordion built on <details>; works without JavaScript. */
interface Props {
  items: { q: string; a: string }[];
  /** Open the first item, as on the live site. */
  openFirst?: boolean;
}
const { items, openFirst = true } = Astro.props;
---
<div class="faq">
  {items.map((it, i) => (
    <details open={openFirst && i === 0}>
      <summary>{it.q}</summary>
      <div class="answer" set:html={it.a} />
    </details>
  ))}
</div>

<style>
  .faq { background: #fff; border: 1px solid #e5e5e5; border-radius: 10px; box-shadow: 0 2px 8px rgb(0 0 0 / .05); overflow: hidden; }
  details + details { border-top: 1px solid #ececec; }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 22px 22px; cursor: pointer; list-style: none;
    font: 600 15px/1.4 var(--font-body); color: var(--ink);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; flex: none; font: 700 20px/1 var(--font-body); color: var(--red-bright); }
  details[open] summary { color: var(--red-bright); background: var(--pink-25); }
  details[open] summary::after { content: '−'; }
  .answer { padding: 16px 22px 22px; font-size: 14px; line-height: 1.7; }
  .answer :global(p) { margin: 0; }
  .answer :global(a) { color: var(--red); }
</style>
