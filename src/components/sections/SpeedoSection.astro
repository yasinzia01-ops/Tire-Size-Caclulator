---
import SectionHead from '../SectionHead.astro';
import { SPEEDO_COPY } from '../../data/home';
import { speedoResult, type TireSize } from '../../lib/calc/speedo';

interface Props {
  rows: [string, string][];
  /**
   * home: Error | true speed when speedo shows 60.
   * about: Error | at 60 mph actual | what the speedo reads (the About page's column set).
   */
  variant?: 'home' | 'about';
  copy?: string[];
}
const { rows, variant = 'home', copy = SPEEDO_COPY } = Astro.props;

const tire = (s: string): TireSize => {
  const [, w, a, r] = s.match(/^(\d+)\/(\d+)R(\d+)$/)!;
  return { w: Number(w), a: Number(a), r: Number(r) };
};
const data = rows.map(([from, to]) => {
  const r = speedoResult(tire(from), tire(to));
  return {
    from, to, err: r.errText, level: r.verdict.level,
    at60: r.speeds.find((s) => s.indicated === 60)!.actual,
    reads: (60 / (1 + r.err / 100)).toFixed(1),
  };
});
---
<section class="section section--dark">
  <div class="container two-col two-col--center">
    <div>
      <SectionHead eyebrow="Speed Accuracy" title="Speedometer Error & Tire Size" />
      <div class="prose prose--dark">
        {copy.map((p) => <p set:html={p} />)}
      </div>
      <p class="formula">
        Speedo Error % = ((New Circumference − Original Circumference) ÷ Original Circumference) × 100<br />
        Actual Speed = Displayed Speed × (New Circ ÷ Original Circ)
      </p>
    </div>
    <div class="speedo-card">
      <h3>Speedo error at common tire size changes</h3>
      <div class="table-scroll">
        <table>
          {variant === 'home' ? (
            <>
              <thead><tr><th scope="col">Size change</th><th scope="col">Error</th><th scope="col">Speedo 60 = actual</th></tr></thead>
              <tbody>{data.map((r) => <tr><td>{r.from} → {r.to}</td><td class={`lvl-${r.level}`}>{r.err}</td><td>{r.at60} mph</td></tr>)}</tbody>
            </>
          ) : (
            <>
              <thead><tr><th scope="col">Size Change</th><th scope="col">Error %</th><th scope="col">At 60mph actual</th><th scope="col">Speedo reads</th></tr></thead>
              <tbody>{data.map((r) => <tr><td>{r.from} → {r.to}</td><td class={`lvl-${r.level}`}>{r.err}</td><td>60 mph</td><td>{r.reads} mph</td></tr>)}</tbody>
            </>
          )}
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .formula { margin: 30px 0 0; padding: 22px 16px; background: rgb(192 0 26 / .12); border: 1px solid rgb(237 28 36 / .4); border-radius: 5px; font: 700 13px/2.3 var(--font-display); color: var(--red-bright); }
  .speedo-card { border: 1px solid #fff; border-radius: 10px; padding: 24px; background: rgb(255 255 255 / .03); }
  .speedo-card h3 { margin: 0 0 16px; font: 700 12px/1.4 var(--font-body); letter-spacing: 1px; text-transform: uppercase; color: rgb(255 255 255 / .7); }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { padding: 8px 6px; text-align: left; font: 700 11px/1.3 var(--font-body); letter-spacing: .5px; text-transform: uppercase; color: rgb(255 255 255 / .45); border-bottom: 1px solid rgb(255 255 255 / .15); }
  td { padding: 10px 6px; color: rgb(255 255 255 / .85); border-bottom: 1px solid rgb(255 255 255 / .08); white-space: nowrap; }
  tr:last-child td { border-bottom: 0; }
  .lvl-ok { color: #6bff8e; font-weight: 700; }
  .lvl-warn { color: #ffc107; font-weight: 700; }
  .lvl-bad { color: #ff6b6b; font-weight: 700; }
</style>
