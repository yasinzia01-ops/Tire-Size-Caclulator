---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostGrid from '../../components/PostGrid.astro';
import { POSTS } from '../../data/posts';
---
<BaseLayout
  title="Blog - Tire Size Calculator"
  description="Guides on wheel offset, backspacing, poke and tire fitment: clear explanations to help you choose the right wheel and tire size."
>
  <section class="archive-head"><div class="container"><h1>Blog</h1></div></section>
  <section class="section"><div class="container"><PostGrid posts={POSTS} headingLevel="h2" /></div></section>
</BaseLayout>

<style>
  .archive-head { background: #000; padding-block: 60px; }
  h1 { margin: 0; color: #fff; font: 900 52px/1.1 var(--font-display); }
  @media (max-width: 767px) { h1 { font-size: 36px; } .archive-head { padding-block: 40px; } }
</style>
