---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const LINKS = [
  { href: '/', label: 'Tire Size Calculator' },
  { href: '/speedometer-error-calculator/', label: 'Speedometer Error Calculator' },
  { href: '/tire-revolutions-per-mile-calculator/', label: 'Tire Revolutions Per Mile Calculator' },
  { href: '/wheel-offset/', label: 'Wheel Offset Calculator' },
  { href: '/blog/', label: 'Blog' },
];
---
<BaseLayout title="Page Not Found - Tire Size Calculator" description="The page you were looking for could not be found." path="/404/" noindex>
  <PageHeader title="Page Not Found" />
  <section class="section">
    <div class="container">
      <p class="lead">Sorry, that page doesn't exist or has moved. Try one of our free tools instead:</p>
      <ul>{LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
  </section>
</BaseLayout>

<style>
  ul { margin: 24px 0 0; padding-left: 20px; display: grid; gap: 10px; font-size: 17px; }
</style>
