---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostGrid from '../../components/PostGrid.astro';
import { CATEGORIES, POSTS } from '../../data/posts';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}
const { category } = Astro.props;
const posts = POSTS.filter((p) => p.category.slug === category.slug);
---
<BaseLayout
  title={`${category.name} - Tire Size Calculator`}
  description={`Wheel offset guides: ${posts.map((p) => p.title).join(', ')}.`}
>
  <section class="archive-head"><div class="container"><h1>Category: {category.name}</h1></div></section>
  <section class="section"><div class="container"><PostGrid posts={posts} excerpt headingLevel="h2" /></div></section>
</BaseLayout>

<style>
  .archive-head { background: #000; padding-block: 60px; }
  h1 { margin: 0; color: #fff; font: 900 52px/1.1 var(--font-display); }
  @media (max-width: 767px) { h1 { font-size: 36px; } .archive-head { padding-block: 40px; } }
</style>
