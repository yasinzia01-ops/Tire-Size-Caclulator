---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevsPerMileCalculator from '../components/calculators/RevsPerMileCalculator.astro';
import { cleanLegacyHtml, faqSchemaFromHtml, faqToDetails } from '../lib/legacyHtml';
import raw from '../content/pages/tire-revolutions-per-mile-calculator.html?raw';
import { SITE } from '../data/site';

const html = faqToDetails(cleanLegacyHtml(raw).html);
const faq = faqSchemaFromHtml(html);
const app = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Tire Revolutions Per Mile Calculator',
  url: `${SITE.url}/tire-revolutions-per-mile-calculator/`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<BaseLayout
  title="Tire Revolutions Per Mile Calculator | RPM by Tire Size"
  description="Calculate tire revolutions per mile instantly. Enter any tire size and get exact RPM, compare OEM vs new tires, and see speedometer impact."
  schema={[app, faq]}
>
  <div class="rpm-page">
    <section class="hero">
      <div class="container">
        <p class="hero-eyebrow">Free Online Tool</p>
        <h1>Tire Revolutions Per Mile Calculator</h1>
        <p class="hero-sub">Enter any tire size and instantly calculate how many revolutions per mile your tires make — and how a size change affects your speedometer.</p>
        <a href="#calculator" class="btn">Calculate Now</a>
        <a href="#what-is-rpm" class="btn btn-outline">Learn More</a>
      </div>
    </section>

    <section class="calc-section" id="calculator">
      <div class="container"><RevsPerMileCalculator /></div>
    </section>

    <Fragment set:html={html} />
  </div>
</BaseLayout>

<style is:global>
  /* Legacy widget styles, scoped to this page. */
  .rpm-page { font: 400 16px/1.6 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #333; }
  .rpm-page .container { max-width: 1140px; margin: 0 auto; padding: 0 20px; }
  .rpm-page h1, .rpm-page h2, .rpm-page h3 { font-family: var(--font-display); line-height: 1.15; }
  .rpm-page h2 { font-size: clamp(22px, 3vw, 30px); font-weight: 700; color: var(--navy); margin: 0 0 12px; }
  .rpm-page h3 { font-size: 20px; font-weight: 700; color: var(--navy); margin: 0 0 8px; }
  .rpm-page p { margin: 0 0 14px; color: #333; }
  .rpm-page a { color: var(--red-bright); text-decoration: none; }
  .rpm-page a:hover { text-decoration: underline; }
  .rpm-page .section-pad { padding: 60px 0; }
  .rpm-page .section-pad-sm { padding: 40px 0; }
  .rpm-page .section-white { background: #fff; }
  .rpm-page .section-gray, .rpm-page .calc-section { background: var(--gray-100); }
  .rpm-page .section-navy { background: var(--navy); }
  .rpm-page .section-navy h2, .rpm-page .section-navy h3 { color: #fff; }
  .rpm-page .section-navy p { color: rgb(255 255 255 / .85); }

  .rpm-page .hero { background: var(--red); padding: 56px 0 48px; text-align: center; border-bottom: 4px solid rgb(0 0 0 / .15); }
  .rpm-page .hero-eyebrow { font: 600 14px/1.6 var(--font-display); letter-spacing: 2px; text-transform: uppercase; color: rgb(255 255 255 / .75); margin-bottom: 12px; }
  .rpm-page .hero h1 { font-size: clamp(36px, 6vw, 64px); font-weight: 900; color: #fff; margin: 0 0 16px; }
  .rpm-page .hero-sub { font-size: 18px; color: rgb(255 255 255 / .88); max-width: 640px; margin: 0 auto 28px; line-height: 1.5; }
  .rpm-page .btn { display: inline-block; padding: 14px 32px; background: var(--red-bright); color: #fff; font: 700 18px/1.4 var(--font-display); letter-spacing: .5px; border-radius: 6px; border: 0; cursor: pointer; transition: background .2s; }
  .rpm-page .btn:hover { background: #c50d14; text-decoration: none; color: #fff; }
  .rpm-page .btn-outline { background: transparent; border: 2px solid rgb(255 255 255 / .7); margin-left: 12px; }
  .rpm-page .btn-outline:hover { background: rgb(255 255 255 / .1); }
  .rpm-page .calc-section { padding: 48px 0; }

  .rpm-page .section-label { display: block; margin-bottom: 8px; font: 700 12px/1.6 var(--font-display); letter-spacing: 2px; text-transform: uppercase; color: var(--red-bright); }
  .rpm-page .section-navy .section-label { color: rgb(255 255 255 / .6) !important; }
  .rpm-page .koray-answer { display: block; background: #f0f4ff; border-left: 4px solid var(--navy); border-radius: 0 6px 6px 0; padding: 14px 18px; margin: 10px 0 22px; font-size: 15px; font-weight: 500; line-height: 1.55; }
  .rpm-page .section-navy .koray-answer { background: rgb(255 255 255 / .1); border-left-color: var(--red-bright); color: rgb(255 255 255 / .92); }
  .rpm-page .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px; margin-top: 24px; }
  .rpm-page .info-card { height: 100%; background: #fff; border-radius: 8px; padding: 22px; border: 1.5px solid #e0e0e0; box-shadow: 0 2px 8px rgb(0 0 0 / .05); }
  .rpm-page .section-navy .info-card { background: rgb(255 255 255 / .08); border-color: rgb(255 255 255 / .15); }
  .rpm-page .info-card h3 { font-size: 17px; margin-bottom: 8px; }
  .rpm-page .section-navy .info-card p { color: rgb(255 255 255 / .82); }
  .rpm-page .number-badge { display: inline-block; background: var(--red-bright); color: #fff; font: 900 28px/1.3 var(--font-display); padding: 4px 14px; border-radius: 4px; margin-bottom: 8px; }
  .rpm-page .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; align-items: start; }
  .rpm-page .data-table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 14px; }
  .rpm-page .data-table th { background: var(--navy); color: #fff; padding: 9px 14px; text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .4px; }
  .rpm-page .data-table td { padding: 8px 14px; border-bottom: 1px solid #e0e0e0; color: #333; }
  .rpm-page .data-table tr:nth-child(even) td { background: var(--gray-100); }
  .rpm-page .code-block { background: #f8f8f8; border: 1px solid #e0e0e0; border-radius: 6px; padding: 16px 18px; font: 14px/1.8 'Courier New', Courier, monospace; margin: 12px 0 16px; color: var(--navy); overflow-x: auto; }
  .rpm-page .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 20px; }
  .rpm-page .related-card { display: block; background: #fff; border: 1.5px solid #e0e0e0; border-radius: 8px; padding: 18px 20px; color: #333; }
  .rpm-page .rc-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; color: var(--red-bright); margin-bottom: 6px; }
  .rpm-page .related-card h3 { font-size: 16px; margin-bottom: 4px; }
  .rpm-page .related-card p:last-child { font-size: 13px; color: #666; margin-bottom: 0; }

  .rpm-page .faq-item { border-bottom: 1px solid #e0e0e0; }
  .rpm-page .faq-q { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 0; list-style: none; cursor: pointer; font: 700 19px/1.3 var(--font-display); color: var(--navy); }
  .rpm-page .faq-q::-webkit-details-marker { display: none; }
  .rpm-page .faq-q::after { content: '+'; font-size: 22px; color: var(--red-bright); flex-shrink: 0; }
  .rpm-page details[open] > .faq-q::after { content: '\2212'; }
  .rpm-page .faq-a { padding: 0 0 16px; font-size: 15px; line-height: 1.6; }

  @media (max-width: 768px) {
    .rpm-page .two-col { grid-template-columns: 1fr; }
    .rpm-page .section-pad { padding: 40px 0; }
    .rpm-page .hero { padding: 40px 0 32px; }
    .rpm-page .btn-outline { margin-left: 0; margin-top: 10px; }
    .rpm-page .data-table { display: block; overflow-x: auto; }
  }
</style>
